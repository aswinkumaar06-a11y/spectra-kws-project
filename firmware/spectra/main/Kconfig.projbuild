menu "Spectra KWS Audio Configuration"

    config SPECTRA_I2S_BCLK_GPIO
        int "I2S Bit Clock (BCLK) GPIO"
        default 1
        help
            GPIO pin connected to INMP441 SCK/BCLK (default 1 = D0 on XIAO ESP32-C5).

    config SPECTRA_I2S_WS_GPIO
        int "I2S Word Select (WS/LRCLK) GPIO"
        default 0
        help
            GPIO pin connected to INMP441 WS (default 0 = D1 on XIAO ESP32-C5).

    config SPECTRA_I2S_DIN_GPIO
        int "I2S Data In (DIN/SD) GPIO"
        default 23
        help
            GPIO pin connected to INMP441 SD (default 23 = D4 on XIAO ESP32-C5).
            Avoids GPIO 11 (U0TXD ROM boot conflict).

    config SPECTRA_RING_SECONDS
        int "Audio ring buffer duration in seconds"
        default 3
        range 2 10
        help
            Duration of the PSRAM audio ring buffer in seconds. Default 3s = 48,000 samples (96 KB).

    config SPECTRA_USE_WAV_INJECTOR
        bool "Enable synthetic test pattern injector instead of live I2S"
        default n
        help
            When enabled, the audio pipeline feeds synthetic deterministic PCM blocks
            for testing and verification without requiring a physical INMP441 microphone.

    config SPECTRA_MFCC_SELFTEST
        bool "Run MFCC golden self-test on boot"
        default y
        help
            Executes built-in MFCC feature extraction parity check on boot before streaming.

    config SPECTRA_MFCC_UART_TEST
        bool "Enable interactive UART MFCC parity harness mode"
        default n
        help
            Waits for host-streamed audio clips over UART to benchmark and verify MFCC parity.

endmenu
